{% extends 'base.html.twig' %}

{% block title %}Mes demandes d’adoption — Pawly{% endblock %}

{% block body %}
    <h1>Mes demandes d’adoption</h1>
    <p>Retrouvez ici les demandes envoyées depuis votre compte et leur état de traitement.</p>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Animal</th><th>Date</th><th>Votre projet</th><th>Statut</th></tr></thead>
            <tbody>
                {% for adoption in adoptions %}
                    <tr>
                        <td><a href="{{ path('dog_show', {id: adoption.dog.id}) }}">{{ adoption.dog.nom }}</a></td>
                        <td>{{ adoption.createdAt|date('d/m/Y') }}</td>
                        <td>{{ adoption.message }}</td>
                        <td>{{ adoption.status.value }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Vous n’avez pas encore envoyé de demande depuis votre compte.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p><a href="{{ path('home') }}#animals">Découvrir les animaux disponibles</a></p>
{% endblock %}
