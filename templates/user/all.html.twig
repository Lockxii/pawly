{% extends 'base.html.twig' %}

{% block title %}Utilisateurs — Pawly{% endblock %}

{% block body %}
    <h1>Gestion des utilisateurs</h1>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Nom</th><th>E-mail</th><th>Rôles</th><th>Gestion</th></tr></thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td><td>{{ user.email }}</td><td>{{ user.roles|join(', ') }}</td>
                        <td><a href="{{ path('admin_user_edit', {id: user.id}) }}">Modifier {{ user.username }}</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Aucun utilisateur.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
