{% extends 'base.html.twig' %}

{% block title %}Gestion des animaux — Pawly{% endblock %}

{% block body %}
    <div class="section-heading">
        <h1>Gestion des animaux</h1>
        <a class="button" href="{{ path('app_dog_creator') }}">Ajouter un animal</a>
    </div>
    <p>Tous les animaux du refuge, y compris ceux en cours d’adoption ou adoptés.</p>
    {% include 'dogs/_search.html.twig' with {searchForm: searchForm, reset_route: 'all'} only %}
    <div class="animal-grid">
        {% for dog in dogs %}
            {% include 'dogs/_card.html.twig' with {dog: dog} only %}
        {% else %}
            <p class="empty-state">{{ searchForm.vars.submitted ? 'Aucun animal ne correspond à votre recherche.' : 'Aucun animal enregistré pour le moment.' }}</p>
        {% endfor %}
    </div>
{% endblock %}
